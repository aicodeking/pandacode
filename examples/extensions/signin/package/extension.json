{
  "manifestVersion": 1,
  "id": "sample.signin",
  "version": "1.0.0",
  "name": "Sample cloud sign-in",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "workspace",
  "permissions": ["ui.contribute", "runtime.service", "secrets.private", "auth.signIn", "ui.dynamic", "ui.notify"],
  "requiredContributions": ["providers"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "files": ["lib"], "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.signin/sign-in", "title": "Sign in to Sample cloud", "action": { "kind": "runCommand" } },
      { "id": "sample.signin/add-account", "title": "Add a Sample cloud account", "action": { "kind": "runCommand" } },
      { "id": "sample.signin/sign-out", "title": "Sign out of Sample cloud", "action": { "kind": "runCommand" } },
      { "id": "sample.signin/accounts", "title": "Sample cloud accounts", "action": { "kind": "runCommand" } }
    ],
    "providers": [{
      "apiVersion": 1,
      "id": "sample.signin/cloud",
      "name": "Sample cloud",
      "metadata": {
        "modes": ["ask"],
        "authentication": "Sign in with the sample identity server. The package keeps its own tokens; PandaCode never hands one to a program.",
        "readiness": { "state": "signedOut", "reason": "Sign in to use Sample cloud." },
        "usage": { "context": true, "limitsReason": "Read from the account after sign-in." },
        "signIn": { "command": "sample.signin/sign-in" },
        "signOut": { "command": "sample.signin/sign-out" }
      },
      "models": [],
      "launch": {
        "protocol": "acp",
        "command": ["{node}", "__FAKE_AGENT__"],
        "env": { "FAKE_AGENT_LOG": "{data}/frames.log" }
      }
    }],
    "settings": [
      { "id": "sample.signin/settings", "title": "Sample cloud", "fields": [
        { "id": "identity", "kind": "text", "label": "Identity server address", "value": "http://127.0.0.1:7431", "required": true },
        { "id": "api", "kind": "text", "label": "API address", "value": "http://127.0.0.1:7432", "required": true },
        { "id": "client", "kind": "text", "label": "Client id", "value": "sample-client", "required": true },
        { "id": "wait", "kind": "text", "label": "Seconds to wait for the browser", "value": "30", "required": true }
      ] }
    ]
  }
}
