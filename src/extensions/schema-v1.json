{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pandacode:extensions:contracts:1",
  "x-dataLimits": { "bytes": 262144, "depth": 32, "nodes": 8192, "packages": 64, "numberBytes": 32 },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "id": { "type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)?$" },
    "version": { "type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]{0,5})[.](0|[1-9][0-9]{0,5})[.](0|[1-9][0-9]{0,5})$" },
    "strings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "key": { "enum": ["windowId", "surfaceId", "projectId", "sessionId", "selection.kind", "revision"] },
    "expression": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "object", "required": ["op", "key"], "additionalProperties": false, "properties": { "op": { "const": "has" }, "key": { "$ref": "#/$defs/key" } } },
        { "type": "object", "required": ["op", "key", "value"], "additionalProperties": false, "properties": { "op": { "const": "eq" }, "key": { "$ref": "#/$defs/key" }, "value": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }] } } },
        { "type": "object", "required": ["op", "arg"], "additionalProperties": false, "properties": { "op": { "const": "not" }, "arg": { "$ref": "#/$defs/expression" } } },
        { "type": "object", "required": ["op", "args"], "additionalProperties": false, "properties": { "op": { "enum": ["all", "any"] }, "args": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/expression" } } } }
      ]
    },
    "action": {
      "anyOf": [
        { "type": "object", "required": ["kind", "message"], "additionalProperties": false, "properties": { "kind": { "const": "showMessage" }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
        { "type": "object", "required": ["kind", "view"], "additionalProperties": false, "properties": { "kind": { "const": "openView" }, "view": { "$ref": "#/$defs/id" } } }
      ]
    },
    "commandDefinition": { "type": "object", "required": ["id", "title", "action"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "action": { "$ref": "#/$defs/action" }, "icon": { "$ref": "#/$defs/id" } } },
    "registration": { "type": "object", "required": ["extensionId", "version", "activationId"], "properties": { "extensionId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "activationId": { "$ref": "#/$defs/text" } } },
    "emptyPayloadSchema": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "null" } } },
    "command": { "type": "object", "required": ["schemaVersion", "owner", "definition", "capability", "contexts", "inputSchema", "outputSchema"], "properties": { "schemaVersion": { "const": 1 }, "owner": { "$ref": "#/$defs/registration" }, "definition": { "$ref": "#/$defs/commandDefinition" }, "capability": { "const": "ui.contribute" }, "contexts": { "type": "array", "maxItems": 4, "items": { "enum": ["window", "project", "session", "selection"] } }, "inputSchema": { "$ref": "#/$defs/emptyPayloadSchema" }, "outputSchema": { "$ref": "#/$defs/emptyPayloadSchema" } } },
    "icon": { "type": "object", "required": ["id", "asset"], "properties": { "id": { "$ref": "#/$defs/id" }, "asset": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "view": { "type": "object", "required": ["id", "title", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "text": { "type": "string", "maxLength": 4096 } } },
    "contributionDefinition": { "type": "object", "required": ["id", "location", "command"], "properties": { "id": { "$ref": "#/$defs/id" }, "location": { "enum": ["panda.workspace.header.actions", "panda.sidebar.footer"] }, "command": { "$ref": "#/$defs/id" }, "icon": { "$ref": "#/$defs/id" }, "group": { "$ref": "#/$defs/text" }, "order": { "type": "integer", "minimum": -100000, "maximum": 100000 }, "before": { "$ref": "#/$defs/strings" }, "after": { "$ref": "#/$defs/strings" }, "visible": { "$ref": "#/$defs/expression" }, "enabled": { "$ref": "#/$defs/expression" } } },
    "contribution": { "type": "object", "required": ["schemaVersion", "owner", "definition"], "properties": { "schemaVersion": { "const": 1 }, "owner": { "$ref": "#/$defs/registration" }, "definition": { "$ref": "#/$defs/contributionDefinition" } } },
    "surface": { "type": "object", "required": ["schemaVersion", "id", "owner", "kind", "itemKinds", "windows", "platforms", "contexts", "policies", "defaultPosition", "accessibilityLabel"], "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/text" }, "owner": { "const": "panda.core" }, "kind": { "const": "actions" }, "parent": { "$ref": "#/$defs/text" }, "itemKinds": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["command", "separator"] } }, "windows": { "$ref": "#/$defs/strings" }, "platforms": { "type": "array", "maxItems": 3, "items": { "enum": ["windows", "macos", "linux"] } }, "contexts": { "$ref": "#/$defs/strings" }, "policies": { "type": "object", "required": ["hide", "reorder", "replace"], "additionalProperties": false, "properties": { "hide": { "type": "boolean" }, "reorder": { "type": "boolean" }, "replace": { "type": "boolean" } } }, "defaultPosition": { "type": "integer", "minimum": -100000, "maximum": 100000 }, "accessibilityLabel": { "$ref": "#/$defs/text" } } },
    "context": { "type": "object", "required": ["schemaVersion", "windowId", "surfaceId", "revision"], "properties": { "schemaVersion": { "const": 1 }, "windowId": { "$ref": "#/$defs/text" }, "surfaceId": { "$ref": "#/$defs/text" }, "projectId": { "$ref": "#/$defs/text" }, "sessionId": { "$ref": "#/$defs/text" }, "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "selection": { "type": "object", "required": ["kind", "ids"], "properties": { "kind": { "enum": ["file", "task", "project"] }, "ids": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } } } } } },
    "error": { "type": "object", "required": ["schemaVersion", "code", "path", "ids"], "additionalProperties": false, "properties": { "schemaVersion": { "const": 1 }, "code": { "enum": ["InvalidShape", "LimitExceeded", "InvalidId", "ReservedId", "DuplicateId", "InvalidVersionRange", "IncompatibleApi", "IncompatibleDependency", "DependencyCycle", "OrderingCycle", "UnknownReference", "UnsupportedCapability", "UnsupportedContribution", "UnsupportedRuntime", "UnsafeAsset", "PermissionDenied", "NotFound", "StaleContext", "Conflict", "Cancelled", "Timeout", "HostUnavailable"] }, "path": { "type": "string", "maxLength": 512 }, "ids": { "$ref": "#/$defs/strings" }, "requestId": { "$ref": "#/$defs/text" } } },
    "placement": { "type": "object", "required": ["id", "target", "side"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/text" }, "target": { "$ref": "#/$defs/text" }, "side": { "enum": ["before", "after"] } } },
    "layout": { "type": "object", "required": ["id", "title", "location", "rules"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "location": { "enum": ["panda.workspace.header.actions", "panda.sidebar.footer"] }, "rules": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/placement" } } } },
    "manifest": {
      "type": "object", "required": ["manifestVersion", "id", "version", "engines", "extensionKind", "permissions", "contributes"],
      "properties": {
        "manifestVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" },
        "engines": { "type": "object", "required": ["pandacodeApi"], "properties": { "pandacodeApi": { "$ref": "#/$defs/text" } } },
        "extensionKind": { "const": "ui" }, "permissions": { "$ref": "#/$defs/strings" }, "requiredCapabilities": { "$ref": "#/$defs/strings" }, "optionalCapabilities": { "$ref": "#/$defs/strings" }, "requiredContributions": { "$ref": "#/$defs/strings" },
        "dependencies": { "type": "object", "maxProperties": 64, "additionalProperties": { "$ref": "#/$defs/text" } },
        "contributes": { "type": "object", "properties": {
          "commands": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/commandDefinition" } },
          "menus": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/contributionDefinition" } },
          "icons": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/icon" } },
          "views": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/view" } },
          "layouts": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/layout" } }
        } }
      }
    }
  }
}
