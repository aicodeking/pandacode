{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pandacode:extensions:contracts:1",
  "x-dataLimits": { "bytes": 262144, "depth": 32, "nodes": 8192, "packages": 64, "numberBytes": 32 },
  "x-menuLimits": { "depth": 5, "items": 128 },
  "x-projectReads": { "capabilities": ["projects.files.metadata", "projects.files.read", "projects.git.read"], "resources": ["metadata", "file", "git"], "scope": "exact-relative-file-or-local-head", "fileBytes": 131072, "pageBytes": 4096, "pathBytes": 1024, "pathComponents": 32, "links": "denied", "git": "local-HEAD-only-no-process" },
  "$defs": {
    "providerModel": { "type": "object", "additionalProperties": false, "required": ["id", "name", "efforts"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "$ref": "#/$defs/text" }, "efforts": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9-]*$" } }, "contextWindow": { "type": "integer", "minimum": 1, "maximum": 10000000 } } },
    "providerMetadata": { "type": "object", "additionalProperties": false, "required": ["modes", "authentication", "readiness", "usage"], "properties": {
      "modes": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["ask", "auto", "plan", "full"] } },
      "authentication": { "$ref": "#/$defs/text" },
      "teams": { "type": "boolean" },
      "icon": { "$ref": "#/$defs/id" },
      "readiness": { "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": { "state": { "enum": ["ready", "signedOut", "unavailable"] }, "reason": { "$ref": "#/$defs/text" } } },
      "usage": { "type": "object", "additionalProperties": false, "required": ["context", "limitsReason"], "properties": { "context": { "type": "boolean" }, "limitsReason": { "$ref": "#/$defs/text" } } }
    } },
    "discoveryRoot": { "type": "object", "additionalProperties": false, "required": ["kind", "scope", "path"], "properties": { "kind": { "enum": ["skills", "rules", "config"] }, "scope": { "enum": ["user", "project"] }, "path": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "provider": { "type": "object", "additionalProperties": false, "required": ["id", "name", "apiVersion", "models"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "apiVersion": { "const": 1 }, "metadata": { "$ref": "#/$defs/providerMetadata" }, "discovery": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/discoveryRoot" } }, "models": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/providerModel" } } } },
    "servicePayload": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "enum": ["null", "string", "boolean", "integer"] } } },
    "service": { "type": "object", "required": ["id", "version", "methods"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "methods": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object", "required": ["id", "inputSchema", "outputSchema", "eventSchema"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/fieldId" }, "inputSchema": { "$ref": "#/$defs/servicePayload" }, "outputSchema": { "$ref": "#/$defs/servicePayload" }, "eventSchema": { "$ref": "#/$defs/servicePayload" } } } } } },
    "connection": { "type": "object", "additionalProperties": false, "required": ["id", "command", "title", "authentication", "adapter", "operations", "timeoutMs"], "properties": { "id": { "$ref": "#/$defs/id" }, "command": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "authentication": { "$ref": "#/$defs/text" }, "adapter": { "const": "json-summary" }, "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }, "operations": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "method", "url"], "properties": { "id": { "$ref": "#/$defs/fieldId" }, "method": { "const": "GET" }, "url": { "type": "string", "minLength": 1, "maxLength": 1024 } } } } } },
    "tool": { "type": "object", "additionalProperties": false, "required": ["id", "command", "executable", "arguments", "cwd", "timeoutMs"], "properties": { "id": { "$ref": "#/$defs/id" }, "command": { "$ref": "#/$defs/id" }, "executable": { "const": "node" }, "arguments": { "type": "object", "additionalProperties": false, "required": ["maxItems", "maxLength"], "properties": { "maxItems": { "type": "integer", "minimum": 0, "maximum": 32 }, "maxLength": { "type": "integer", "minimum": 1, "maximum": 1024 } } }, "cwd": { "const": "project" }, "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 } } },
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "id": { "type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)?$" },
    "version": { "type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]{0,5})[.](0|[1-9][0-9]{0,5})[.](0|[1-9][0-9]{0,5})$" },
    "strings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "key": { "enum": ["windowId", "surfaceId", "projectId", "sessionId", "selection.kind", "revision"] },
    "expression": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "object", "required": ["op", "key"], "additionalProperties": false, "properties": { "op": { "const": "has" }, "key": { "$ref": "#/$defs/key" } } },
        { "type": "object", "required": ["op", "key", "value"], "additionalProperties": false, "properties": { "op": { "const": "eq" }, "key": { "$ref": "#/$defs/key" }, "value": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }] } } },
        { "type": "object", "required": ["op", "arg"], "additionalProperties": false, "properties": { "op": { "const": "not" }, "arg": { "$ref": "#/$defs/expression" } } },
        { "type": "object", "required": ["op", "args"], "additionalProperties": false, "properties": { "op": { "enum": ["all", "any"] }, "args": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/expression" } } } }
      ]
    },
    "action": {
      "anyOf": [
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "runCommand" } } },
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "showProjectContext" } } },
        { "type": "object", "required": ["kind", "message"], "additionalProperties": false, "properties": { "kind": { "const": "showMessage" }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
        { "type": "object", "required": ["kind", "view"], "additionalProperties": false, "properties": { "kind": { "const": "openView" }, "view": { "$ref": "#/$defs/id" } } },
        { "type": "object", "required": ["kind", "dialog"], "additionalProperties": false, "properties": { "kind": { "const": "showDialog" }, "dialog": { "$ref": "#/$defs/dialog" } } }
      ]
    },
    "fieldId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" },
    "selectOption": { "type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": { "value": { "$ref": "#/$defs/text" }, "label": { "$ref": "#/$defs/text" }, "disabled": { "type": "boolean" } } },
    "selectOptions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/selectOption" } },
    "dialogField": { "anyOf": [
      { "type": "object", "required": ["id", "kind", "label"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/fieldId" }, "kind": { "const": "text" }, "label": { "$ref": "#/$defs/text" }, "value": { "type": "string", "maxLength": 4096 }, "required": { "type": "boolean" }, "minLength": { "type": "integer", "minimum": 0, "maximum": 4096 } } },
      { "type": "object", "required": ["id", "kind", "label"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/fieldId" }, "kind": { "const": "switch" }, "label": { "$ref": "#/$defs/text" }, "value": { "type": "boolean" } } },
      { "type": "object", "required": ["id", "kind", "label", "options"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/fieldId" }, "kind": { "const": "select" }, "label": { "$ref": "#/$defs/text" }, "options": { "$ref": "#/$defs/selectOptions" }, "multiple": { "type": "boolean" }, "async": { "type": "boolean" }, "required": { "type": "boolean" }, "placeholder": { "$ref": "#/$defs/text" } } }
    ] },
    "dialog": { "type": "object", "required": ["title", "fields", "successMessage"], "additionalProperties": false, "properties": { "title": { "$ref": "#/$defs/text" }, "fields": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/dialogField" } }, "confirmLabel": { "$ref": "#/$defs/text" }, "confirmation": { "$ref": "#/$defs/text" }, "successMessage": { "$ref": "#/$defs/text" }, "cancelMessage": { "$ref": "#/$defs/text" } } },
    "commandDefinition": { "type": "object", "required": ["id", "title", "action"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "action": { "$ref": "#/$defs/action" }, "icon": { "$ref": "#/$defs/id" }, "enabled": { "$ref": "#/$defs/expression" } } },
    "registration": { "type": "object", "required": ["extensionId", "version", "activationId"], "properties": { "extensionId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "activationId": { "$ref": "#/$defs/text" } } },
    "emptyPayloadSchema": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "null" } } },
    "command": { "type": "object", "required": ["schemaVersion", "owner", "definition", "capability", "contexts", "inputSchema", "outputSchema"], "properties": { "schemaVersion": { "const": 1 }, "owner": { "$ref": "#/$defs/registration" }, "definition": { "$ref": "#/$defs/commandDefinition" }, "capability": { "const": "ui.contribute" }, "contexts": { "type": "array", "maxItems": 4, "items": { "enum": ["window", "project", "session", "selection"] } }, "inputSchema": { "$ref": "#/$defs/emptyPayloadSchema" }, "outputSchema": { "$ref": "#/$defs/emptyPayloadSchema" } } },
    "icon": { "type": "object", "required": ["id", "asset"], "properties": { "id": { "$ref": "#/$defs/id" }, "asset": { "type": "string", "minLength": 1, "maxLength": 256 }, "host": { "enum": ["file", "folder", "help", "settings", "down", "right", "search", "plus"] } } },
    "appearanceColors": { "type": "object", "additionalProperties": false, "required": ["background", "foreground", "accent"], "properties": { "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "foreground": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } },
    "theme": { "type": "object", "additionalProperties": false, "required": ["id", "schemaVersion", "light", "dark"], "properties": { "id": { "$ref": "#/$defs/id" }, "schemaVersion": { "const": 1 }, "light": { "$ref": "#/$defs/appearanceColors" }, "dark": { "$ref": "#/$defs/appearanceColors" }, "font": { "enum": ["system", "sans-serif", "monospace"] }, "rowPadding": { "type": "integer", "minimum": 4, "maximum": 12 }, "radius": { "type": "integer", "minimum": 4, "maximum": 16 } } },
    "viewTreeItem": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": { "label": { "$ref": "#/$defs/text" }, "children": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/viewTreeItem" } } } },
    "viewControl": { "anyOf": [
      { "type": "object", "required": ["kind", "label", "items"], "additionalProperties": false, "properties": { "kind": { "const": "list" }, "label": { "$ref": "#/$defs/text" }, "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } } } },
      { "type": "object", "required": ["kind", "label", "items"], "additionalProperties": false, "properties": { "kind": { "const": "tree" }, "label": { "$ref": "#/$defs/text" }, "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/viewTreeItem" } } } },
      { "type": "object", "required": ["kind", "label", "columns", "rows"], "additionalProperties": false, "properties": { "kind": { "const": "table" }, "label": { "$ref": "#/$defs/text" }, "columns": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/text" } }, "rows": { "type": "array", "maxItems": 100, "items": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/text" } } } } },
      { "type": "object", "required": ["kind", "label", "items"], "additionalProperties": false, "properties": { "kind": { "const": "tabs" }, "label": { "$ref": "#/$defs/text" }, "items": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object", "required": ["label", "text"], "additionalProperties": false, "properties": { "label": { "$ref": "#/$defs/text" }, "text": { "type": "string", "maxLength": 4096 } } } } } },
      { "type": "object", "required": ["kind", "label", "value"], "additionalProperties": false, "properties": { "kind": { "const": "progress" }, "label": { "$ref": "#/$defs/text" }, "value": { "type": "integer", "minimum": 0, "maximum": 100 } } }
    ] },
    "richView": { "type": "object", "required": ["html", "css", "script"], "additionalProperties": false, "properties": { "html": { "type": "string", "maxLength": 160, "pattern": "^assets/[a-zA-Z0-9_/-]+[.]html$" }, "css": { "type": "string", "maxLength": 160, "pattern": "^assets/[a-zA-Z0-9_/-]+[.]css$" }, "script": { "type": "string", "maxLength": 160, "pattern": "^assets/[a-zA-Z0-9_/-]+[.]js$" } } },
    "view": { "type": "object", "required": ["id", "title", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "text": { "type": "string", "maxLength": 4096 }, "rich": { "$ref": "#/$defs/richView" }, "controls": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/viewControl" } }, "toolbar": { "type": "array", "maxItems": 16, "items": { "type": "object", "required": ["command"], "additionalProperties": false, "properties": { "command": { "$ref": "#/$defs/id" } } } } } },
    "menuItem": { "type": "object", "required": ["id", "kind"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["command", "submenu", "separator", "checkbox", "radio"] }, "title": { "$ref": "#/$defs/text" }, "command": { "$ref": "#/$defs/id" }, "icon": { "$ref": "#/$defs/id" }, "checked": { "type": "boolean" }, "group": { "$ref": "#/$defs/text" }, "visible": { "$ref": "#/$defs/expression" }, "enabled": { "$ref": "#/$defs/expression" }, "items": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/menuItem" } } } },
    "actionLocation": { "enum": ["panda.workspace.header.actions", "panda.sidebar.footer", "panda.inspector.actions", "panda.inspector.files.toolbar", "panda.inspector.files.context", "panda.inspector.changes.toolbar", "panda.inspector.changes.context", "panda.inspector.search.toolbar", "panda.inspector.search.context", "panda.sidebar.project.context", "panda.sidebar.task.context", "panda.documents.actions", "panda.documents.context", "panda.changes.actions", "panda.composer.actions", "panda.composer.tray", "panda.composer.attachments", "panda.thread.header", "panda.thread.message.actions", "panda.thread.trace.actions", "panda.actionDock.actions", "panda.team.actions", "panda.agents.actions", "panda.status.items", "panda.dialog.colors.actions", "panda.dialog.wallpapers.actions", "panda.tray.actions", "panda.tray.menu", "panda.launcher.actions", "panda.agentsDock.actions"] },
    "contributionDefinition": { "type": "object", "required": ["id", "location", "command"], "properties": { "id": { "$ref": "#/$defs/id" }, "location": { "$ref": "#/$defs/actionLocation" }, "command": { "$ref": "#/$defs/id" }, "icon": { "$ref": "#/$defs/id" }, "presentation": { "enum": ["icon", "button", "status", "badge"] }, "text": { "$ref": "#/$defs/text" }, "badge": { "type": "string", "minLength": 1, "maxLength": 16 }, "items": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/menuItem" } }, "group": { "$ref": "#/$defs/text" }, "order": { "type": "integer", "minimum": -100000, "maximum": 100000 }, "before": { "$ref": "#/$defs/strings" }, "after": { "$ref": "#/$defs/strings" }, "visible": { "$ref": "#/$defs/expression" }, "enabled": { "$ref": "#/$defs/expression" } } },
    "contribution": { "type": "object", "required": ["schemaVersion", "owner", "definition"], "properties": { "schemaVersion": { "const": 1 }, "owner": { "$ref": "#/$defs/registration" }, "definition": { "$ref": "#/$defs/contributionDefinition" } } },
    "surface": { "type": "object", "required": ["schemaVersion", "id", "owner", "kind", "itemKinds", "windows", "platforms", "contexts", "policies", "defaultPosition", "accessibilityLabel"], "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/text" }, "owner": { "const": "panda.core" }, "kind": { "const": "actions" }, "parent": { "$ref": "#/$defs/text" }, "itemKinds": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["command", "separator"] } }, "windows": { "$ref": "#/$defs/strings" }, "platforms": { "type": "array", "maxItems": 3, "items": { "enum": ["windows", "macos", "linux"] } }, "contexts": { "$ref": "#/$defs/strings" }, "policies": { "type": "object", "required": ["hide", "reorder", "replace"], "additionalProperties": false, "properties": { "hide": { "type": "boolean" }, "reorder": { "type": "boolean" }, "replace": { "type": "boolean" } } }, "defaultPosition": { "type": "integer", "minimum": -100000, "maximum": 100000 }, "accessibilityLabel": { "$ref": "#/$defs/text" } } },
    "context": { "type": "object", "required": ["schemaVersion", "windowId", "surfaceId", "revision"], "properties": { "schemaVersion": { "const": 1 }, "windowId": { "$ref": "#/$defs/text" }, "surfaceId": { "$ref": "#/$defs/text" }, "projectId": { "$ref": "#/$defs/text" }, "sessionId": { "$ref": "#/$defs/text" }, "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "selection": { "type": "object", "required": ["kind", "ids"], "properties": { "kind": { "enum": ["file", "task", "project", "message", "trace", "team", "repository"] }, "ids": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } } } } } },
    "error": { "type": "object", "required": ["schemaVersion", "code", "path", "ids"], "additionalProperties": false, "properties": { "schemaVersion": { "const": 1 }, "code": { "enum": ["InvalidShape", "LimitExceeded", "InvalidId", "ReservedId", "DuplicateId", "InvalidVersionRange", "IncompatibleApi", "IncompatibleDependency", "DependencyCycle", "OrderingCycle", "UnknownReference", "UnsupportedCapability", "UnsupportedContribution", "UnsupportedRuntime", "UnsafeAsset", "PermissionDenied", "NotFound", "StaleContext", "Conflict", "Cancelled", "Timeout", "HostUnavailable"] }, "path": { "type": "string", "maxLength": 512 }, "ids": { "$ref": "#/$defs/strings" }, "requestId": { "$ref": "#/$defs/text" } } },
    "placement": { "type": "object", "required": ["id", "target", "side"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/text" }, "target": { "$ref": "#/$defs/text" }, "side": { "enum": ["before", "after"] } } },
    "layoutLocation": { "anyOf": [{ "$ref": "#/$defs/actionLocation" }, { "enum": ["panda.documents.navigation", "panda.documents.tabs", "panda.documents.viewer", "panda.changes.controls", "panda.changes.file", "panda.changes.viewer"] }] },
    "layout": { "type": "object", "required": ["id", "title", "location", "rules"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "location": { "$ref": "#/$defs/layoutLocation" }, "rules": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/placement" } } } },
    "manifest": {
      "type": "object", "required": ["manifestVersion", "id", "version", "engines", "extensionKind", "permissions", "contributes"],
      "properties": {
        "manifestVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" },
        "runtime": { "type": "object", "required": ["kind", "entrypoint", "activationEvents"], "additionalProperties": false, "properties": { "kind": { "const": "node" }, "entrypoint": { "const": "main.cjs" }, "activationEvents": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/id" } } } },
        "engines": { "type": "object", "required": ["pandacodeApi"], "properties": { "pandacodeApi": { "$ref": "#/$defs/text" } } },
        "extensionKind": { "enum": ["ui", "workspace", "split"] }, "permissions": { "$ref": "#/$defs/strings" }, "requiredCapabilities": { "$ref": "#/$defs/strings" }, "optionalCapabilities": { "$ref": "#/$defs/strings" }, "requiredContributions": { "$ref": "#/$defs/strings" },
        "dependencies": { "type": "object", "maxProperties": 64, "additionalProperties": { "$ref": "#/$defs/text" } },
        "contributes": { "type": "object", "properties": {
          "services": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/service" } },
          "providers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/provider" } },
          "connections": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/connection" } },
          "tools": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/tool" } },
          "commands": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/commandDefinition" } },
          "menus": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/contributionDefinition" } },
          "icons": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/icon" } },
          "themes": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/theme" } },
          "components": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/componentProvider" } },
          "views": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/view" } },
          "layouts": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/layout" } },
          "settings": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/settingsPage" } },
          "keybindings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/keybinding" } },
          "dialogExtras": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/dialogExtra" } }
        } }
      }
    },
    "settingsPage": { "type": "object", "required": ["id", "title", "fields"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "fields": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/dialogField" } } } },
    "keybinding": { "type": "object", "required": ["id", "command", "key"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "command": { "$ref": "#/$defs/id" }, "key": { "type": "string", "maxLength": 32, "pattern": "^Mod[+](Shift[+])?(Alt[+])?Key[A-Z]$" } } },
