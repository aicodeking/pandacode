{
  "manifestVersion": 1,
  "id": "sample.upstream-workers",
  "version": "1.0.0",
  "engines": {
    "pandacodeApi": "^1.0.0"
  },
  "extensionKind": "ui",
  "permissions": [
    "ui.contribute",
    "ui.customize",
    "tasks.summary"
  ],
  "contributes": {
    "components": [
      {
        "id": "sample.upstream-workers/actions-first",
        "title": "Workers and dock, actions first",
        "slot": "panda.actionDock",
        "contractVersion": 1,
        "presentation": "actions-first",
        "capabilities": [
          "host-groups",
          "host-workers",
          "original-actions"
        ]
      }
    ],
    "commands": [
      {
        "id": "sample.upstream-workers/workers-note",
        "title": "Workers note",
        "action": {
          "kind": "showMessage",
          "message": "Workers, approvals, effort and Stop stay with PandaCode."
        }
      },
      {
        "id": "sample.upstream-workers/dock-note",
        "title": "Dock note",
        "action": {
          "kind": "showMessage",
          "message": "The Running agents window keeps its own errors."
        }
      }
    ],
    "menus": [
      {
        "id": "sample.upstream-workers/team",
        "command": "sample.upstream-workers/workers-note",
        "location": "panda.team.actions",
        "presentation": "button",
        "text": "Workers note"
      },
      {
        "id": "sample.upstream-workers/agents-dock",
        "command": "sample.upstream-workers/dock-note",
        "location": "panda.agentsDock.actions",
        "presentation": "button",
        "text": "Dock note"
      },
      {
        "id": "sample.upstream-workers/team-context",
        "command": "sample.upstream-workers/workers-note",
        "location": "panda.team.context",
        "visible": {
          "op": "eq",
          "key": "selection.kind",
          "value": "team"
        }
      }
    ],
    "layouts": [
      {
        "id": "sample.upstream-workers/menu-first",
        "title": "Open team before Workers",
        "location": "panda.team.controls",
        "rules": [
          {
            "id": "panda.team.controls/menu",
            "target": "panda.team.controls/toggle",
            "side": "before"
          }
        ]
      }
    ]
  }
}
