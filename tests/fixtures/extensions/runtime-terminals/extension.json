{
  "manifestVersion": 1,
  "id": "sample.runtime-terminals",
  "version": "1.0.0",
  "name": "Terminal helper",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "terminals.read", "terminals.write"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-terminals/control", "title": "Terminal helper control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-terminals/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-terminals/control", "presentation": "button", "text": "Terminals" }
    ]
  }
}
