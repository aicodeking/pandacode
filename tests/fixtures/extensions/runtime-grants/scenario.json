{
  "description": "Two-project fixture: grant one project, restart, call the other project directly, narrow, revoke and repeat. Read by the native test in src-tauri/src/extensions/runtime_grants.rs and by tests/extensions-runtime-grants.spec.ts.",
  "package": {
    "id": "sample.grants-laboratory",
    "version": "1.0.0",
    "permissions": ["ui.customize", "tasks.start", "harness.hooks.decide", "credentials.use", "projects.checks.run"]
  },
  "projects": ["project-a", "project-b"],
  "steps": [
    { "op": "check", "permission": "tasks.start", "project": "project-a", "expect": "PermissionDenied" },
    { "op": "grant", "permission": "tasks.start", "scope": { "projects": ["project-a"] } },
    { "op": "grant", "permission": "ui.customize" },
    { "op": "grant", "permission": "harness.hooks.decide", "scope": { "projects": ["project-a", "project-b"], "toolKinds": ["shell", "edit"] } },
    { "op": "grant", "permission": "credentials.use", "scope": { "items": ["github", "openai"] } },
    { "op": "grant", "permission": "projects.checks.run", "scope": { "projects": ["project-b"] } },
    { "op": "check", "permission": "tasks.start", "project": "project-a", "expect": "ok" },
    { "op": "check", "permission": "tasks.start", "project": "project-b", "expect": "PermissionDenied" },
    { "op": "restart" },
    { "op": "check", "permission": "tasks.start", "project": "project-a", "expect": "ok" },
    { "op": "check", "permission": "tasks.start", "project": "project-b", "expect": "PermissionDenied" },
    { "op": "check", "permission": "ui.customize", "expect": "ok" },
    { "op": "check", "permission": "projects.checks.run", "project": "project-a", "expect": "PermissionDenied" },
    { "op": "check", "permission": "projects.checks.run", "project": "project-b", "expect": "ok" },
    { "op": "narrow", "permission": "harness.hooks.decide", "scope": { "projects": ["project-a"], "toolKinds": ["shell"] } },
    { "op": "narrow", "permission": "credentials.use", "scope": { "items": ["github"] } },
    { "op": "check", "permission": "harness.hooks.decide", "project": "project-a", "toolKind": "shell", "expect": "ok" },
    { "op": "check", "permission": "harness.hooks.decide", "project": "project-a", "toolKind": "edit", "expect": "PermissionDenied" },
    { "op": "check", "permission": "harness.hooks.decide", "project": "project-b", "toolKind": "shell", "expect": "PermissionDenied" },
    { "op": "check", "permission": "credentials.use", "item": "github", "expect": "ok" },
    { "op": "check", "permission": "credentials.use", "item": "openai", "expect": "PermissionDenied" },
    { "op": "restart" },
    { "op": "check", "permission": "harness.hooks.decide", "project": "project-a", "toolKind": "edit", "expect": "PermissionDenied" },
    { "op": "check", "permission": "credentials.use", "item": "openai", "expect": "PermissionDenied" },
    { "op": "revoke", "permission": "tasks.start" },
    { "op": "check", "permission": "tasks.start", "project": "project-a", "expect": "PermissionDenied" },
    { "op": "restart" },
    { "op": "check", "permission": "tasks.start", "project": "project-a", "expect": "PermissionDenied" },
    { "op": "check", "permission": "ui.customize", "expect": "ok" },
    { "op": "grant", "permission": "tasks.start", "scope": { "projects": ["project-b"] } },
    { "op": "check", "permission": "tasks.start", "project": "project-b", "expect": "ok" },
    { "op": "check", "permission": "tasks.start", "project": "project-a", "expect": "PermissionDenied" },
    { "op": "check", "permission": "credentials.read", "expect": "UnsupportedCapability" }
  ]
}
