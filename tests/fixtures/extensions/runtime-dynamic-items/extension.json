{
  "manifestVersion": 1,
  "id": "sample.dynamic-items",
  "version": "1.0.0",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "events.workspace", "ui.dynamic"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.dynamic-items/open", "title": "Open a live row", "action": { "kind": "runCommand" } },
      { "id": "sample.dynamic-items/control", "title": "Dynamic items control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.dynamic-items/status", "location": "panda.status.items", "command": "sample.dynamic-items/open", "presentation": "status", "text": "idle" },
      { "id": "sample.dynamic-items/header", "location": "panda.workspace.header.actions", "command": "sample.dynamic-items/control", "presentation": "button", "text": "Dynamic items" }
    ],
    "views": [
      {
        "id": "sample.dynamic-items/board",
        "title": "Live tables",
        "text": "No tables yet.",
        "controls": [{ "kind": "table", "label": "Tables", "columns": ["Name"], "rows": [] }]
      }
    ]
  }
}
