{
  "manifestVersion": 1,
  "id": "sample.launch-agent",
  "version": "1.0.0",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "workspace",
  "permissions": ["ui.contribute"],
  "requiredContributions": ["providers"],
  "contributes": {
    "providers": [{
      "apiVersion": 1,
      "id": "sample.launch-agent/fake",
      "name": "Launched fake agent",
      "metadata": {
        "modes": ["ask"],
        "authentication": "Offline fixture; the declared fake ACP agent needs no sign-in or API key.",
        "readiness": { "state": "ready", "reason": "Ready offline through its declared ACP launch." },
        "usage": { "context": true, "limitsReason": "The fake agent reports context tokens, not subscription limits. No account or network is used." }
      },
      "models": [],
      "launch": {
        "protocol": "acp",
        "command": ["{node}", "__FAKE_AGENT__"],
        "env": { "FAKE_AGENT_LOG": "{data}/frames.log" }
      }
    }]
  }
}
