{
  "manifestVersion": 1,
  "id": "sample.runtime-workspace-schedules",
  "version": "1.0.0",
  "name": "Recipes and wake-ups",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "workspace.manage"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-workspace-schedules/control", "title": "Recipes and wake-ups control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-workspace-schedules/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-workspace-schedules/control", "presentation": "button", "text": "Recipes and wake-ups" }
    ]
  }
}
