{
  "manifestVersion": 1,
  "id": "sample.runtime-workspace-cloud",
  "version": "1.0.0",
  "name": "Workspace manager",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "workspace.manage"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-workspace-cloud/control", "title": "Workspace manager control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-workspace-cloud/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-workspace-cloud/control", "presentation": "button", "text": "Manage workspace" }
    ]
  }
}
