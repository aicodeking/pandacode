{
  "schemaVersion": 1,
  "provenance": "Hand-recorded from the interface's own call sites (not captured from a live run): Stop button src/main.ts stopTask (architect_control for a team, stop_session otherwise), src/model-switch.ts (configure_session, update_session, set_reasoning_effort with the warm argument the pickers pass), src/main.ts team menu (architect_configure with the profile's setup, or null setup to remove the team), connection_assign, bot_assign_task, set_task_stage, and a typed /compact (send_message). Each case names the facts of the task and the request a service sends; `commands` is what the interface calls for the same choice, in order. The same file is read by tests/extensions-runtime-tasks-control.spec.ts (src/extensions/runtime-tasks-control.ts `plan`) and by runtime_tasks_control::tests (runtime_tasks_control.rs `plan`).",
  "cases": [
    { "name": "stop a plain task", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "stop", "taskId": "t1" },
      "commands": [ { "command": "stop_session", "args": { "sessionId": "t1" } } ] },
    { "name": "stop a team", "task": { "harness": "claude", "model": "sonnet", "team": true, "remote": false },
      "request": { "action": "stop", "taskId": "t1" },
      "commands": [ { "command": "architect_control", "args": { "sessionId": "t1", "action": "stop" } } ] },
    { "name": "stop a mirror of a team on another machine", "task": { "harness": "claude", "model": "sonnet", "team": true, "remote": true },
      "request": { "action": "stop", "taskId": "t1" },
      "commands": [ { "command": "stop_session", "args": { "sessionId": "t1" } } ] },
    { "name": "set the mode", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "setMode", "taskId": "t1", "mode": "plan" },
      "commands": [ { "command": "update_session", "args": { "sessionId": "t1", "mode": "plan", "warm": true } } ] },
    { "name": "switch harness and model", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "harness": "codex", "model": "gpt-5" } },
      "commands": [ { "command": "configure_session", "args": { "sessionId": "t1", "provider": "codex", "model": "gpt-5", "projectId": null, "warm": true } } ] },
    { "name": "switch the model only keeps the harness", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "model": "haiku" } },
      "commands": [ { "command": "configure_session", "args": { "sessionId": "t1", "provider": "claude", "model": "haiku", "projectId": null, "warm": true } } ] },
    { "name": "set and clear the effort", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "effort": "high" } },
      "commands": [ { "command": "set_reasoning_effort", "args": { "sessionId": "t1", "reasoningEffort": "high", "warm": true } } ] },
    { "name": "clear the effort", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "effort": null } },
      "commands": [ { "command": "set_reasoning_effort", "args": { "sessionId": "t1", "reasoningEffort": null, "warm": true } } ] },
    { "name": "apply a team profile", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "team": "review-squad" } },
      "commands": [ { "command": "architect_configure", "args": { "sessionId": "t1", "config": { "fromProfile": "review-squad" }, "architect": { "fromProfile": "review-squad" }, "profileId": "review-squad" } } ] },
    { "name": "remove the team", "task": { "harness": "claude", "model": "sonnet", "team": true, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "team": null } },
      "commands": [ { "command": "architect_configure", "args": { "sessionId": "t1", "config": null, "architect": null, "profileId": null } } ] },
    { "name": "assign and clear a connection", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "connection": "work-account" } },
      "commands": [ { "command": "connection_assign", "args": { "sessionId": "t1", "connectionId": "work-account" } } ] },
    { "name": "link a bot", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "bot": "release-bot" } },
      "commands": [ { "command": "bot_assign_task", "args": { "sessionId": "t1", "botId": "release-bot" } } ] },
    { "name": "choose where a new conversation runs", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "target": "studio" } },
      "commands": [ { "command": "run_on", "args": { "sessionId": "t1", "target": "studio" } } ] },
    { "name": "settle a task", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "stage": "completed" } },
      "commands": [ { "command": "set_task_stage", "args": { "sessionId": "t1", "stage": "completed" } } ] },
    { "name": "every field at once keeps the interface's order", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "configure", "taskId": "t1", "change": { "stage": "active", "target": "local", "bot": null, "connection": null, "team": null, "effort": "low", "harness": "codex", "model": "gpt-5" } },
      "commands": [
        { "command": "configure_session", "args": { "sessionId": "t1", "provider": "codex", "model": "gpt-5", "projectId": null, "warm": true } },
        { "command": "set_reasoning_effort", "args": { "sessionId": "t1", "reasoningEffort": "low", "warm": true } },
        { "command": "architect_configure", "args": { "sessionId": "t1", "config": null, "architect": null, "profileId": null } },
        { "command": "connection_assign", "args": { "sessionId": "t1", "connectionId": null } },
        { "command": "bot_assign_task", "args": { "sessionId": "t1", "botId": null } },
        { "command": "run_on", "args": { "sessionId": "t1", "target": "local" } },
        { "command": "set_task_stage", "args": { "sessionId": "t1", "stage": "active" } }
      ] },
    { "name": "compact the context", "task": { "harness": "claude", "model": "sonnet", "team": false, "remote": false },
      "request": { "action": "compact", "taskId": "t1" },
      "commands": [ { "command": "send_message", "args": { "sessionId": "t1", "text": "/compact" } } ] }
  ]
}
