{
  "manifestVersion": 1,
  "id": "sample.runtime-tasks-messages",
  "version": "1.0.0",
  "name": "Task messenger",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "tasks.message", "harness.hooks.context"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-tasks-messages/control", "title": "Task messenger control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-tasks-messages/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-tasks-messages/control", "presentation": "button", "text": "Message task" }
    ]
  }
}
