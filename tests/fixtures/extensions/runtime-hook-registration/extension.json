{
  "manifestVersion": 1,
  "id": "sample.hook-observer",
  "version": "1.0.0",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "workspace",
  "permissions": ["ui.contribute", "runtime.service", "harness.hooks.observe"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.hook-observer/control", "title": "Hook observer control", "action": { "kind": "runCommand" } }
    ],
    "hooks": [
      { "id": "sample.hook-observer/turn-start", "event": "turn.start", "match": { "runs": ["task"] } },
      { "id": "sample.hook-observer/prompt", "event": "prompt.submit", "onFailure": "deny", "budgetMs": 5000 },
      { "id": "sample.hook-observer/before", "event": "tool.before", "onFailure": "ask", "match": { "toolKinds": ["shell", "edit"], "harnesses": ["fake-agent"] } },
      { "id": "sample.hook-observer/after", "event": "tool.after", "budgetMs": 2000, "match": { "extensions": [".ts"] } },
      { "id": "sample.hook-observer/finish", "event": "turn.finish" },
      { "id": "sample.hook-observer/fail", "event": "turn.fail" },
      { "id": "sample.hook-observer/idle", "event": "task.idle" },
      { "id": "sample.hook-observer/compaction", "event": "compaction", "match": { "harnesses": ["*"] } }
    ]
  }
}
