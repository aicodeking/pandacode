{
  "manifestVersion": 1,
  "id": "sample.fake-harness",
  "version": "1.0.0",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "activationEvents": ["sample.fake-harness/recorded"] },
  "requiredContributions": ["providers"],
  "contributes": { "providers": [{ "apiVersion": 1, "id": "sample.fake-harness/recorded", "name": "Recorded harness", "models": [{ "id": "recorded-model", "name": "Recorded model", "efforts": ["low", "medium"], "contextWindow": 32000 }] }] }
}
