{
  "manifestVersion": 1,
  "id": "sample.hook-guard",
  "name": "Guard",
  "version": "1.0.0",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "workspace",
  "permissions": ["ui.contribute", "runtime.service", "harness.hooks.observe", "harness.hooks.decide", "ui.presentation"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.hook-guard/control", "title": "Hook guard control", "action": { "kind": "runCommand" } }
    ],
    "hooks": [
      { "id": "sample.hook-guard/before", "event": "tool.before", "onFailure": "ask", "budgetMs": 2000 }
    ]
  }
}
