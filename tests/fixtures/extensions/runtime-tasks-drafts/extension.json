{
  "manifestVersion": 1,
  "id": "sample.runtime-tasks-drafts",
  "version": "1.0.0",
  "name": "Draft helper",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "tasks.draft", "tasks.transcript.read"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-tasks-drafts/control", "title": "Draft helper control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-tasks-drafts/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-tasks-drafts/control", "presentation": "button", "text": "Edit draft" }
    ]
  }
}
