        "dialog": "progress-lightbox",
        "text": "Owned guidance for Progress large view; the host keeps its fields and actions."
      },
      {
        "id": "sample.owned-dialogs/tool-image-viewer-note",
        "dialog": "tool-image-viewer",
        "text": "Owned guidance for Tool image viewer; the host keeps its fields and actions."
      },
      {
        "id": "sample.owned-dialogs/team-model-add-note",
        "dialog": "team-model-add",
        "text": "Owned guidance for Models for teams; the host keeps its fields and actions."
      },
      {
        "id": "sample.owned-dialogs/integrations-note",
        "dialog": "integrations",
        "text": "Owned guidance for Tools & integrations; the host keeps its fields and actions."
      },
      {
        "id": "sample.owned-dialogs/jev-assist-note",
        "dialog": "jev-assist",
