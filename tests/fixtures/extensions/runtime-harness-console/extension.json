{
  "manifestVersion": 1,
  "id": "sample.runtime-harness-console",
  "version": "1.0.0",
  "name": "Console helper",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "harness.console"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-harness-console/control", "title": "Console helper control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-harness-console/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-harness-console/control", "presentation": "button", "text": "Open console" }
    ]
  }
}
