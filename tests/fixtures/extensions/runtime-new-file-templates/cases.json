{
  "provenance": "synthetic",
  "note": "Shared by runtime_new_file_templates::tests (native) and tests/extensions-runtime-new-file-templates.spec.ts (preview twin). A refusal case starts from the first newFiles item of extension.json (sample.notes/note): `set` changes fields, `drop` removes them, `extra` appends more derived items, `count` replaces the list with that many copies, `permissions` replaces the manifest permissions; `{pad:N}` stands for N x characters. A flow creates a file through `create` in project p1 over a disk that already holds `existing`; the templates are the files of ./templates ('# New note' and 'DAT1', each with a final newline). A reveal opens a file of `files` through `reveal` as the package sample.notes.",
  "refusals": [
    { "id": "reserved-id", "set": { "id": "panda.note" }, "expect": { "code": "ReservedId", "at": "contributes/newFiles", "ids": ["panda.note"] } },
    { "id": "foreign-id", "set": { "id": "other.pkg/note" }, "expect": { "code": "InvalidId", "at": "contributes/newFiles", "ids": ["other.pkg/note"] } },
    { "id": "duplicate-id", "extra": [{ "set": {} }], "expect": { "code": "DuplicateId", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "title-missing", "drop": ["title"], "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "title-too-long", "set": { "title": "{pad:81}" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "extension-missing", "drop": ["extension"], "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "extension-without-dot", "set": { "extension": "note" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "extension-uppercase", "set": { "extension": ".NOTE" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "extension-too-long", "set": { "extension": ".abcdefghijklmnopq" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-missing", "drop": ["template"], "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-traversal", "set": { "template": "templates/../secret.note" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-absolute", "set": { "template": "/templates/empty.note" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-backslash", "set": { "template": "templates\\empty.note" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-drive", "set": { "template": "C:/templates/empty.note" }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-folder-not-shipped", "set": { "template": "elsewhere/empty.note" }, "expect": { "code": "UnknownReference", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "template-outside-a-folder", "set": { "template": "empty.note" }, "expect": { "code": "UnknownReference", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "editor-not-declared", "set": { "editor": "sample.notes/ghost" }, "expect": { "code": "UnknownReference", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "editor-does-not-handle-the-type", "set": { "editor": "sample.notes/hex" }, "expect": { "code": "UnknownReference", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "editor-not-a-string", "set": { "editor": 5 }, "expect": { "code": "InvalidShape", "at": "contributes/newFiles", "ids": ["sample.notes/note"] } },
    { "id": "seventeen-items", "count": 17, "expect": { "code": "LimitExceeded", "at": "contributes/newFiles", "ids": ["sample.notes"] } },
    { "id": "without-the-documents-editors-grant", "permissions": ["ui.contribute"], "expect": { "code": "PermissionDenied", "at": "permissions", "ids": ["sample.notes"] } }
  ],
  "flows": [
    { "id": "declared-editor-opens-the-template", "item": "sample.notes/note", "name": "notes/today", "expect": { "ok": true, "path": "notes/today.note", "editor": "sample.notes/note", "reason": "declared", "bytes": 11, "content": "# New note\n", "encoding": "text" } },
    { "id": "name-with-the-extension-is-kept", "item": "sample.notes/note", "name": "Today.NOTE", "expect": { "ok": true, "path": "Today.NOTE", "editor": "sample.notes/note", "reason": "declared", "bytes": 11, "content": "# New note\n", "encoding": "text" } },
    { "id": "user-override-wins-over-the-declared-editor", "item": "sample.notes/note", "name": "today", "choice": "sample.notes/plain", "expect": { "ok": true, "path": "today.note", "editor": "sample.notes/plain", "reason": "override", "bytes": 11, "content": "# New note\n", "encoding": "text" } },
    { "id": "user-override-to-the-built-in-editor", "item": "sample.notes/note", "name": "today", "choice": "builtin", "expect": { "ok": true, "path": "today.note", "editor": "builtin", "reason": "override", "bytes": 11, "content": "# New note\n", "encoding": "text" } },
    { "id": "bytes-editor-gets-a-bytes-buffer", "item": "sample.notes/data", "name": "blob", "expect": { "ok": true, "path": "blob.dat", "editor": "sample.notes/hex", "reason": "declared", "bytes": 5, "content": "DAT1\n", "encoding": "bytes" } },
    { "id": "item-without-an-editor-uses-the-selection", "item": "sample.notes/blank", "name": "scratch", "expect": { "ok": true, "path": "scratch.note", "editor": "sample.notes/note", "reason": "selected", "bytes": 11, "content": "# New note\n", "encoding": "text" } },
    { "id": "item-without-an-editor-and-the-package-gone-opens-the-built-in-editor", "item": "sample.notes/blank", "name": "scratch", "editorGone": true, "expect": { "ok": true, "path": "scratch.note", "editor": "builtin", "reason": "selected", "bytes": 11, "content": "# New note\n", "encoding": "text" } },
    { "id": "unknown-item", "item": "sample.notes/ghost", "name": "x", "expect": { "ok": false, "code": "NotFound", "what": "item" } },
    { "id": "stale-project", "item": "sample.notes/note", "name": "today", "staleProject": true, "expect": { "ok": false, "code": "StaleContext", "what": "project" } },
    { "id": "revoked-grant", "item": "sample.notes/note", "name": "today", "grant": false, "expect": { "ok": false, "code": "PermissionDenied", "what": "grant" } },
    { "id": "file-conflict-never-overwrites", "item": "sample.notes/note", "name": "today", "existing": ["today.note"], "expect": { "ok": false, "code": "Conflict", "what": "file" } },
    { "id": "template-missing-from-the-archive", "item": "sample.notes/note", "name": "today", "templateMissing": true, "expect": { "ok": false, "code": "NotFound", "what": "template" } },
    { "id": "declared-editor-gone", "item": "sample.notes/note", "name": "today", "editorGone": true, "expect": { "ok": false, "code": "NotFound", "what": "editor" } },
    { "id": "override-names-an-unknown-editor", "item": "sample.notes/note", "name": "today", "choice": "sample.notes/ghost", "expect": { "ok": false, "code": "NotFound", "what": "editor" } },
    { "id": "override-names-an-editor-of-another-type", "item": "sample.notes/note", "name": "today", "choice": "sample.notes/hex", "expect": { "ok": false, "code": "NotFound", "what": "editor" } },
    { "id": "path-empty", "item": "sample.notes/note", "name": "  ", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-parent-segment", "item": "sample.notes/note", "name": "../outside", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-inside-parent-segment", "item": "sample.notes/note", "name": "a/../../outside", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-absolute", "item": "sample.notes/note", "name": "/etc/today", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-drive-letter", "item": "sample.notes/note", "name": "C:/today", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-backslash", "item": "sample.notes/note", "name": "a\\today", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-empty-segment", "item": "sample.notes/note", "name": "a//today", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-reserved-windows-name", "item": "sample.notes/note", "name": "NUL", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "path-with-another-extension", "item": "sample.notes/note", "name": "today.sql", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } }
  ],
  "reveals": [
    { "id": "named-package-editor", "files": { "a.note": "hello" }, "path": "a.note", "editor": "sample.notes/note", "expect": { "ok": true, "editor": "sample.notes/note", "reason": "chosen" } },
    { "id": "named-option-editor", "files": { "a.note": "hello" }, "path": "a.note", "editor": "sample.notes/plain", "expect": { "ok": true, "editor": "sample.notes/plain", "reason": "chosen" } },
    { "id": "no-editor-uses-the-default", "files": { "a.note": "hello" }, "path": "a.note", "expect": { "ok": true, "editor": "sample.notes/note", "reason": "selected" } },
    { "id": "named-built-in-editor", "files": { "a.note": "hello" }, "path": "a.note", "editor": "builtin", "expect": { "ok": true, "editor": "builtin", "reason": "chosen" } },
    { "id": "unknown-editor", "files": { "a.note": "hello" }, "path": "a.note", "editor": "sample.notes/ghost", "expect": { "ok": false, "code": "NotFound", "what": "editor" } },
    { "id": "missing-file", "files": {}, "path": "none.note", "expect": { "ok": false, "code": "NotFound", "what": "file" } },
    { "id": "caller-without-ui-dynamic", "files": { "a.note": "hello" }, "path": "a.note", "dynamic": false, "expect": { "ok": false, "code": "PermissionDenied", "what": "grant" } },
    { "id": "path-outside-the-project", "files": {}, "path": "../a.note", "expect": { "ok": false, "code": "InvalidShape", "what": "path" } },
    { "id": "packages-disabled-opens-the-built-in-editor", "files": { "a.note": "hello" }, "path": "a.note", "editorGone": true, "expect": { "ok": true, "editor": "builtin", "reason": "selected" } },
    { "id": "packages-disabled-named-editor-is-refused", "files": { "a.note": "hello" }, "path": "a.note", "editor": "sample.notes/note", "editorGone": true, "expect": { "ok": false, "code": "NotFound", "what": "editor" } }
  ]
}
