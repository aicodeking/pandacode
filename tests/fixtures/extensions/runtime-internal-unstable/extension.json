{
  "manifestVersion": 1,
  "id": "sample.runtime-internal-unstable",
  "version": "1.0.0",
  "name": "Internal interface probe",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "internal.unstable"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-internal-unstable/control", "title": "Internal interface probe control", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-internal-unstable/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-internal-unstable/control", "presentation": "button", "text": "Internal probe" }
    ]
  }
}
