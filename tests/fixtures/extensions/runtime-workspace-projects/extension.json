{
  "manifestVersion": 1,
  "id": "sample.runtime-workspace-projects",
  "version": "1.0.0",
  "name": "Workspace manager",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "workspace.manage", "projects.checks.run"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-workspace-projects/run", "title": "Workspace manager run", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-workspace-projects/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-workspace-projects/run", "presentation": "button", "text": "Manage workspace" }
    ]
  }
}
