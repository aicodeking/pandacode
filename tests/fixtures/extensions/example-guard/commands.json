{
  "schema": 1,
  "label": "synthetic: written for the Command guard example (sample.guard); no real harness, shell or secret",
  "posix": { "cwd": "/work/project", "root": "/work/project", "home": "/home/dev", "temp": ["/tmp", "/var/tmp"] },
  "windows": { "cwd": "C:\\work\\project", "root": "C:\\work\\project", "home": "C:\\Users\\dev", "temp": ["C:\\Temp"] },
  "policy": { "rules": [{ "command": "terraform", "blockArgs": ["destroy"], "reason": "Destroying infrastructure needs a person." }] },
  "cases": [
    { "command": "git status", "expect": "allow" },
    { "command": "git log --oneline -5", "expect": "allow" },
    { "command": "git diff HEAD", "expect": "allow" },
    { "command": "git reset --hard", "expect": "deny", "rule": "git.reset-hard" },
    { "command": "git reset --hard HEAD~1", "expect": "deny", "rule": "git.reset-hard" },
    { "command": "git -C other reset --hard", "expect": "deny", "rule": "git.reset-hard" },
    { "command": "git reset --soft HEAD~1", "expect": "allow" },
    { "command": "git push origin main", "expect": "allow" },
    { "command": "git push --force origin main", "expect": "deny", "rule": "git.push-force", "rewritable": true },
    { "command": "git push -f origin main", "expect": "deny", "rule": "git.push-force", "rewritable": true },
    { "command": "git push origin +main", "expect": "deny", "rule": "git.push-force" },
    { "command": "git push --force-with-lease origin main", "expect": "allow" },
    { "command": "git stash", "expect": "allow" },
    { "command": "git stash pop", "expect": "allow" },
    { "command": "git stash drop", "expect": "deny", "rule": "git.stash-drop" },
    { "command": "git stash clear", "expect": "deny", "rule": "git.stash-drop" },
    { "command": "git clean -fd", "expect": "deny", "rule": "git.clean-force" },
    { "command": "git clean -nfd", "expect": "allow" },
    { "command": "git checkout -- .", "expect": "deny", "rule": "git.checkout-discard" },
    { "command": "git checkout .", "expect": "deny", "rule": "git.checkout-discard" },
    { "command": "git checkout main", "expect": "allow" },
    { "command": "git checkout -b feature", "expect": "allow" },
    { "command": "git restore src/a.ts", "expect": "deny", "rule": "git.restore-worktree" },
    { "command": "git restore --staged src/a.ts", "expect": "allow" },
    { "command": "git branch -D old", "expect": "deny", "rule": "git.branch-force-delete" },
    { "command": "git branch -d old", "expect": "allow" },
    { "command": "rm file.txt", "expect": "allow" },
    { "command": "rm -r build", "expect": "allow" },
    { "command": "rm -rf ../outside", "expect": "deny", "rule": "rm.outside-project", "levels": ["standard", "strict", "paranoid"] },
    { "command": "rm -rf -- ../outside", "expect": "deny", "rule": "rm.outside-project" },
    { "command": "rm -fr ../outside", "expect": "deny", "rule": "rm.outside-project" },
    { "command": "rm -Rf ../outside", "expect": "deny", "rule": "rm.outside-project" },
    { "command": "rm --recursive --force ../outside", "expect": "deny", "rule": "rm.outside-project" },
    { "command": "rm -rf ~/projects", "expect": "deny", "rule": "rm.outside-project" },
    { "command": "rm -rf ./build", "expect": "allow", "levels": ["standard", "strict"] },
    { "command": "rm -rf ./build", "expect": "deny", "rule": "rm.paranoid-inside", "levels": ["paranoid"] },
    { "command": "rm -rf ./build/*", "expect": "allow" },
    { "command": "rm -rf ./src", "expect": "allow", "levels": ["standard"] },
    { "command": "rm -rf ./src", "expect": "deny", "rule": "rm.strict-inside", "levels": ["strict"] },
    { "command": "rm -rf /tmp/x", "expect": "allow", "levels": ["standard", "strict", "paranoid"] },
    { "command": "rm -rf /var/tmp/work", "expect": "allow" },
    { "command": "rm -rf .", "expect": "deny", "rule": "rm.protected", "levels": ["standard", "strict", "paranoid"] },
    { "command": "rm -rf ~", "expect": "deny", "rule": "rm.protected", "levels": ["standard", "strict", "paranoid"] },
    { "command": "rm -rf $HOME", "expect": "deny", "rule": "rm.protected" },
    { "command": "rm -rf /", "expect": "deny", "rule": "rm.protected" },
    { "command": "rm -rf /tmp", "expect": "deny", "rule": "rm.protected" },
    { "command": "rm -rf *", "expect": "deny", "rule": "rm.protected" },
    { "command": "rm -rf $TARGET_DIR", "expect": "deny", "rule": "rm.unresolved" },
    { "command": "sh -c \"git push --force origin main\"", "expect": "deny", "rule": "git.push-force", "rewritable": false },
    { "command": "sudo env X=1 git stash drop", "expect": "deny", "rule": "git.stash-drop" },
    { "command": "env -i git reset --hard", "expect": "deny", "rule": "git.reset-hard" },
    { "command": "bash -lc \"rm -rf ../outside\"", "expect": "deny", "rule": "rm.outside-project" },
    { "command": "sudo sudo sudo sudo sudo sudo sudo sudo sudo sudo ls", "expect": "allow", "note": "ten wrappers are followed" },
    { "command": "sudo sudo sudo sudo sudo sudo sudo sudo sudo sudo sudo ls", "expect": "deny", "rule": "analysis.recursion-limit", "note": "eleven wrappers are not" },
    { "command": "echo ok | rm -rf ~", "expect": "deny", "rule": "rm.protected", "reasonIncludes": "segment 2" },
    { "command": "echo ok && git reset --hard", "expect": "deny", "rule": "git.reset-hard", "reasonIncludes": "segment 2" },
    { "command": "ls; rm -rf ../outside", "expect": "deny", "rule": "rm.outside-project", "reasonIncludes": "segment 2" },
    { "command": "echo $(rm -rf ~)", "expect": "deny", "rule": "rm.protected" },
    { "command": "echo `git reset --hard`", "expect": "deny", "rule": "git.reset-hard" },
    { "command": "terraform plan", "expect": "allow", "policy": true },
    { "command": "terraform destroy", "expect": "deny", "rule": "custom.terraform", "policy": true },
    { "command": "terraform destroy", "expect": "allow", "policy": false },
    { "command": "echo \"unbalanced", "expect": "deny", "rule": "analysis.unparsed" },
    { "command": "", "expect": "deny", "rule": "analysis.malformed" },
    { "command": "printf hi > .sample-guard/policy.json", "expect": "deny", "rule": "guard.policy-protected" },
    { "command": "rm .sample-guard/policy.json", "expect": "deny", "rule": "guard.policy-protected" },
    { "command": "cat .sample-guard/policy.json", "expect": "allow" },
    { "command": "dd if=/dev/zero of=/dev/sda", "expect": "deny", "rule": "disk.raw-write" },
    { "command": "mkfs.ext4 /dev/sda1", "expect": "deny", "rule": "disk.format" },
    { "command": "ls -la", "expect": "allow" },
    { "command": "npm test", "expect": "allow" },
    { "command": "node scripts/build.mjs", "expect": "allow" },
    { "command": "echo done > out.txt", "expect": "allow" },
    { "command": "Remove-Item -Recurse -Force ..\\outside", "expect": "deny", "rule": "rm.outside-project", "world": "windows" },
    { "command": "Remove-Item -Recurse -Force .\\build", "expect": "allow", "world": "windows" },
    { "command": "rm -rf C:\\Users\\dev", "expect": "deny", "rule": "rm.protected", "world": "windows" },
    { "command": "powershell -Command \"Remove-Item -Recurse -Force C:\\Windows\"", "expect": "deny", "rule": "rm.outside-project", "world": "windows" },
    { "command": "cmd /c rd /s /q C:\\other", "expect": "deny", "rule": "rm.outside-project", "world": "windows" }
  ],
  "paths": [
    { "tool": "write", "path": ".sample-guard/policy.json", "expect": "deny", "rule": "guard.policy-protected" },
    { "tool": "edit", "path": "/work/project/.sample-guard/policy.json", "expect": "deny", "rule": "guard.policy-protected" },
    { "tool": "write", "path": "src/a.ts", "expect": "allow" }
  ]
}
