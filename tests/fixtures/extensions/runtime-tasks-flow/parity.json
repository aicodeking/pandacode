{
  "comment": "R0404B parity recording: the calls the interface (and the window's own functions) make for the same choice. Read by tests/extensions-runtime-tasks-flow.spec.ts and by runtime_tasks_flow::tests. `task` carries what the plan reads of the team.",
  "cases": [
    { "name": "council accept", "task": { "teamActive": true, "teamResumable": false }, "request": { "action": "council", "taskId": "t1", "decision": "accept" }, "commands": [{ "command": "architect_council_accept", "args": { "sessionId": "t1" } }] },
    { "name": "council dismiss", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "council", "taskId": "t1", "decision": "dismiss" }, "commands": [{ "command": "council_dismiss", "args": { "sessionId": "t1" } }] },
    { "name": "council keep fixing", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "council", "taskId": "t1", "decision": "keepFixing" }, "commands": [{ "command": "send_message", "args": { "sessionId": "t1", "text": "Keep fixing until every reviewer reaches the target." } }] },
    { "name": "worker stop", "task": { "teamActive": true, "teamResumable": false }, "request": { "action": "worker", "taskId": "t1", "workerId": "w1", "op": "stop" }, "commands": [{ "command": "architect_worker_control", "args": { "sessionId": "t1", "workerId": "w1", "action": "stop" } }] },
    { "name": "worker skip", "task": { "teamActive": true, "teamResumable": false }, "request": { "action": "worker", "taskId": "t1", "workerId": "w2", "op": "skip" }, "commands": [{ "command": "architect_worker_control", "args": { "sessionId": "t1", "workerId": "w2", "action": "skip" } }] },
    { "name": "worker retry in a running team", "task": { "teamActive": true, "teamResumable": false }, "request": { "action": "worker", "taskId": "t1", "workerId": "w2", "op": "retry" }, "commands": [{ "command": "architect_worker_control", "args": { "sessionId": "t1", "workerId": "w2", "action": "retry" } }] },
    { "name": "worker resume in a running team", "task": { "teamActive": true, "teamResumable": false }, "request": { "action": "worker", "taskId": "t1", "workerId": "w3", "op": "resume" }, "commands": [{ "command": "architect_worker_control", "args": { "sessionId": "t1", "workerId": "w3", "action": "resume" } }] },
    { "name": "worker retry in a paused team is the team's Resume", "task": { "teamActive": false, "teamResumable": true }, "request": { "action": "worker", "taskId": "t1", "workerId": "w2", "op": "retry" }, "commands": [{ "command": "architect_control", "args": { "sessionId": "t1", "action": "resume" } }] },
    { "name": "worker resume in an interrupted team is the team's Resume", "task": { "teamActive": false, "teamResumable": true }, "request": { "action": "worker", "taskId": "t1", "workerId": "w3", "op": "resume" }, "commands": [{ "command": "architect_control", "args": { "sessionId": "t1", "action": "resume" } }] },
    { "name": "worker stop in a paused team still stops the worker", "task": { "teamActive": false, "teamResumable": true }, "request": { "action": "worker", "taskId": "t1", "workerId": "w1", "op": "stop" }, "commands": [{ "command": "architect_worker_control", "args": { "sessionId": "t1", "workerId": "w1", "action": "stop" } }] },
    { "name": "limit continue", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "limit", "taskId": "t1", "op": "continue" }, "commands": [{ "command": "send_message", "args": { "sessionId": "t1", "text": "Continue where you left off." } }] },
    { "name": "limit continue on another connection", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "limit", "taskId": "t1", "op": "continue", "options": { "connection": "work-account" } }, "commands": [{ "command": "continue_on_connection", "args": { "sessionId": "t1", "connectionId": "work-account" } }] },
    { "name": "limit continue naming the task's own harness", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "limit", "taskId": "t1", "op": "continue", "options": { "harness": "claude" } }, "commands": [{ "command": "send_message", "args": { "sessionId": "t1", "text": "Continue where you left off." } }] },
    { "name": "limit resume at reset", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "limit", "taskId": "t1", "op": "resume" }, "commands": [{ "command": "set_resume_at_reset", "args": { "sessionId": "t1", "enabled": true } }] },
    { "name": "limit dismiss", "task": { "teamActive": false, "teamResumable": false }, "request": { "action": "limit", "taskId": "t1", "op": "dismiss" }, "commands": [{ "command": "clear_usage_limit", "args": { "sessionId": "t1" } }] }
