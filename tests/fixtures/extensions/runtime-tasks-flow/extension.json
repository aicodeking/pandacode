{
  "manifestVersion": 1,
  "id": "sample.runtime-tasks-flow",
  "version": "1.0.0",
  "name": "Flow controller",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "tasks.control"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.runtime-tasks-flow/flow", "title": "Flow controller flow", "action": { "kind": "runCommand" } }
    ],
    "menus": [
      { "id": "sample.runtime-tasks-flow/header", "location": "panda.workspace.header.actions", "command": "sample.runtime-tasks-flow/flow", "presentation": "button", "text": "Steer task" }
    ]
  }
}
