{
  "schemaVersion": 1,
  "kind": "runtime-windows-panels-expected",
  "target": "windows-x64",
  "criteria": {
    "C1": "Refusal-test reconciliation for Q025, Q038, Q051, Q052, Q116, Q117 (source edits; not an installed observation).",
    "C2": "The exact source-fingerprinted installed Windows build and its candidate commit.",
    "C3": "Canvas streaming, remote page, action response, per-package storage and state across placements in the installed app.",
    "C4": "A faulting panel does not stop an ongoing fake-agent task; disable, revoke and safe mode leave no frame or channel.",
    "C5": "Runtime and engine versions, actual native evidence and the remaining platform limitations."
  },
  "checks": [
    { "id": "identity.commit", "criterion": "C2", "path": "identity.candidateCommit", "op": "match", "value": "^[0-9a-f]{40}$", "why": "the candidate commit the build was made from" },
    { "id": "identity.fingerprint", "criterion": "C2", "path": "identity.sourceFingerprint", "op": "match", "value": "^[0-9a-f]{64}$", "why": "the source fingerprint of the tree at run time" },
    { "id": "identity.same-source", "criterion": "C2", "path": "identity.buildMatchesSource", "op": "eq", "value": true, "why": "the installed build was made from this exact tree (fingerprint before and after the build equal to the run's)" },
    { "id": "identity.installer", "criterion": "C2", "path": "identity.installer.sha256", "op": "match", "value": "^[0-9a-f]{64}$", "why": "the installer that was installed" },
    { "id": "identity.app", "criterion": "C2", "path": "identity.app.sha256", "op": "match", "value": "^[0-9a-f]{64}$", "why": "the installed executable that ran" },
    { "id": "identity.installed", "criterion": "C2", "path": "identity.installedBy", "op": "eq", "value": "nsis-silent", "why": "an installed app, not a development or preview build" },

    { "id": "engines.webview2", "criterion": "C5", "path": "engines.webview2", "op": "match", "value": "^\\d+\\.\\d+\\.\\d+\\.\\d+$", "why": "the WebView2 runtime version the panels ran in" },
    { "id": "engines.edge", "criterion": "C5", "path": "engines.userAgent", "op": "match", "value": "Edg/", "why": "the main webview is WebView2" },
    { "id": "engines.node", "criterion": "C5", "path": "engines.node", "op": "eq", "value": "v26.1.0", "why": "the pinned packaged runtime" },
    { "id": "engines.os", "criterion": "C5", "path": "engines.os.platform", "op": "eq", "value": "win32", "why": "Windows evidence only; no other platform is inferred" },

    { "id": "setup.errors", "criterion": "C3", "path": "scenarios.setup.errors", "op": "len", "value": 0, "why": "install, trust, enable and grants of the four fixture packages succeeded" },
    { "id": "stream.technique", "criterion": "C3", "path": "scenarios.stream.technique", "op": "eq", "value": "native-webview", "why": "the inspector panel is a child webview, not an iframe" },
    { "id": "stream.min-size", "criterion": "C3", "path": "scenarios.stream.shellHasMinSize", "op": "eq", "value": true, "why": "the #panda-min fragment passed the navigation guard" },
    { "id": "stream.drawn", "criterion": "C3", "path": "scenarios.stream.frames.drawn", "op": "eq", "value": 40, "why": "every streamed frame reached the canvas" },
    { "id": "stream.gaps", "criterion": "C3", "path": "scenarios.stream.frames.gaps", "op": "eq", "value": 0, "why": "in order, none lost" },
    { "id": "stream.done", "criterion": "C3", "path": "scenarios.stream.frames.done.posted", "op": "eq", "value": 40, "why": "the service posted the whole budget" },
    { "id": "stream.pixel", "criterion": "C3", "path": "scenarios.stream.frames.sample.rgba", "op": "deepEqual", "value": [195, 173, 200, 255], "why": "the last frame (seq 39) is on the canvas" },
    { "id": "stream.service", "criterion": "C3", "path": "scenarios.stream.service.delivered", "op": "gte", "value": 40, "why": "the host delivered every frame over the channel" },
    { "id": "stream.refused", "criterion": "C3", "path": "scenarios.stream.service.refused", "op": "eq", "value": 0, "why": "no frame hit a limit" },
    { "id": "action.claimed", "criterion": "C3", "path": "scenarios.action.claim.issueId", "op": "eq", "value": "T-1", "why": "the panel's action reached B1 through the service" },
    { "id": "action.status", "criterion": "C3", "path": "scenarios.action.claim.status", "op": "eq", "value": "in_progress", "why": "B1's answer came back to the panel" },
    { "id": "action.mine", "criterion": "C3", "path": "scenarios.action.claim.mine", "op": "eq", "value": true, "why": "the answer went to the asking instance" },
    { "id": "action.latency", "criterion": "C3", "path": "scenarios.action.claim.ms", "op": "lte", "value": 2000, "why": "the response arrived within 2 s" },
    { "id": "remote.text", "criterion": "C3", "path": "scenarios.remote.text", "op": "eq", "value": "Remote chart: windows panels", "why": "the declared remote page is shown" },
    { "id": "remote.origin", "criterion": "C3", "path": "scenarios.remote.origin", "op": "eq", "value": "https://charts.windows-panels.test", "why": "on its own declared origin" },
    { "id": "remote.framed", "criterion": "C3", "path": "scenarios.remote.framed", "op": "eq", "value": true, "why": "framed by the package shell" },
    { "id": "storage.inspector", "criterion": "C3", "path": "scenarios.storage.boardInspector.local", "op": "eq", "value": "qualification-note", "why": "the board panel stored a note on its origin" },
    { "id": "storage.indexed", "criterion": "C3", "path": "scenarios.storage.boardInspector.indexed", "op": "eq", "value": "qualification-note", "why": "IndexedDB on the same origin" },
    { "id": "storage.window", "criterion": "C3", "path": "scenarios.storage.boardWindow.local", "op": "eq", "value": "qualification-note", "why": "the separate window shares the package's storage" },
    { "id": "storage.window-indexed", "criterion": "C3", "path": "scenarios.storage.boardWindow.indexed", "op": "eq", "value": "qualification-note", "why": "IndexedDB is shared across placements too" },
    { "id": "storage.restart", "criterion": "C3", "path": "scenarios.storage.boardAfterRestart.local", "op": "eq", "value": "qualification-note", "why": "storage survives an app restart" },
    { "id": "storage.twin", "criterion": "C3", "path": "scenarios.storage.twin.local", "op": "eq", "value": null, "why": "another package's origin never sees the board's note" },
    { "id": "storage.twin-own", "criterion": "C3", "path": "scenarios.storage.boardAfterTwinStore.local", "op": "eq", "value": "qualification-note", "why": "the twin's own note does not overwrite the board's" },
    { "id": "storage.origins", "criterion": "C3", "path": "scenarios.storage.distinctOrigins", "op": "eq", "value": true, "why": "one origin per package" },
    { "id": "storage.twin-post", "criterion": "C3", "path": "scenarios.storage.twinPost", "op": "match", "value": "^(UnsupportedCapability|NO_SERVICE)", "why": "a panel-only package has no channel peer (R0303/R0305)" },
    { "id": "state.reload", "criterion": "C3", "path": "scenarios.state.afterReload.restored", "op": "eq", "value": true, "why": "a reload reattaches the inspector instance" },
    { "id": "state.reload-value", "criterion": "C3", "path": "scenarios.state.afterReload.state", "op": "deepEqual", "value": { "note": "remembered" }, "why": "with its state" },
    { "id": "state.window", "criterion": "C3", "path": "scenarios.state.windowInit.placement", "op": "eq", "value": "window", "why": "the same view opened in the separate window" },
    { "id": "state.parked", "criterion": "C3", "path": "scenarios.state.parked.sameDocument", "op": "eq", "value": true, "why": "a parked inspector panel keeps its document" },
    { "id": "state.parked-hidden", "criterion": "C3", "path": "scenarios.state.parked.sawHidden", "op": "eq", "value": true, "why": "the parked panel was told it is hidden" },
    { "id": "inline.alive", "criterion": "C3", "path": "scenarios.inline.aliveAfterMs", "op": "gte", "value": 15000, "why": "the legacy inline form's title heartbeats are not lost (the watchdog ends a panel after 6 s of silence)" },
    { "id": "inline.state", "criterion": "C3", "path": "scenarios.inline.richState", "op": "eq", "value": null, "why": "it was never ended" },
    { "id": "focus.trace", "criterion": "C3", "path": "scenarios.focus.trace", "op": "project", "fields": ["step", "main", "panel"], "value": [
      { "step": "slot-enter", "main": false, "panel": true },
      { "step": "panel-button", "main": false, "panel": true },
      { "step": "escape", "main": true, "panel": false },
      { "step": "re-enter", "main": false, "panel": true },
      { "step": "release-focus", "main": true, "panel": false },
      { "step": "chord-enter", "main": false, "panel": true },
      { "step": "chord", "main": false, "panel": true }
    ], "why": "focus moves between the main and panel webviews only as R0304 says" },
    { "id": "focus.chord", "criterion": "C3", "path": "scenarios.focus.forwarded", "op": "includes", "value": "Control+F12", "why": "a command chord the page left alone reached the app" },
    { "id": "focus.escape-not-forwarded-twice", "criterion": "C3", "path": "scenarios.focus.forwardedCount", "op": "eq", "value": 1, "why": "only the chord was re-dispatched in the main window" },

    { "id": "fault.started", "criterion": "C4", "path": "scenarios.fault.taskId", "op": "match", "value": ".+", "why": "the panel started a fake-agent task through the service" },
    { "id": "fault.failed", "criterion": "C4", "path": "scenarios.fault.panelState", "op": "eq", "value": "error", "why": "the panel faulted and the host ended it" },
    { "id": "fault.no-page", "criterion": "C4", "path": "scenarios.fault.panelPagesAfter", "op": "eq", "value": 0, "why": "the faulted webview is gone" },
    { "id": "fault.running", "criterion": "C4", "path": "scenarios.fault.runningAtFault", "op": "eq", "value": true, "why": "the fault happened while the turn ran" },
    { "id": "fault.finished", "criterion": "C4", "path": "scenarios.fault.turnFinished", "op": "eq", "value": true, "why": "the task's turn finished" },
    { "id": "fault.not-failed", "criterion": "C4", "path": "scenarios.fault.turnFailed", "op": "eq", "value": false, "why": "and did not fail" },
    { "id": "fault.not-stopped", "criterion": "C4", "path": "scenarios.fault.taskStopped", "op": "eq", "value": false, "why": "nobody stopped it" },
    { "id": "fault.no-cancel", "criterion": "C4", "path": "scenarios.fault.agentCancel", "op": "eq", "value": 0, "why": "the fake agent never received session/cancel" },
    { "id": "fault.all-ticks", "criterion": "C4", "path": "scenarios.fault.agentPrompts", "op": "eq", "value": 1, "why": "one prompt, run to its end" },
    { "id": "fault.composer", "criterion": "C4", "path": "scenarios.fault.promptEnabled", "op": "eq", "value": true, "why": "the composer stayed usable" },
    { "id": "fault.reload", "criterion": "C4", "path": "scenarios.fault.reload.restored", "op": "eq", "value": true, "why": "Reload panel brings back the instance and its state" },
    { "id": "band.technique", "criterion": "C3", "path": "scenarios.band.technique", "op": "eq", "value": "native-webview", "why": "the composer band's rich segment is a native panel (R1001)" },
    { "id": "band.webview", "criterion": "C3", "path": "scenarios.band.webview", "op": "eq", "value": true, "why": "its webview exists" },
    { "id": "band.min-height", "criterion": "C3", "path": "scenarios.band.height", "op": "gte", "value": 24, "why": "inside the band's 24 px floor" },
    { "id": "band.max-height", "criterion": "C3", "path": "scenarios.band.height", "op": "lte", "value": 96, "why": "and its 96 px ceiling" },
    { "id": "band.alive", "criterion": "C3", "path": "scenarios.band.aliveAfterMs", "op": "gte", "value": 10000, "why": "it stays alive (its heartbeats arrive)" },
    { "id": "revoke.state", "criterion": "C4", "path": "scenarios.lifecycle.revoke.panelState", "op": "eq", "value": "revoked", "why": "revoking ui.richViews ends the panel" },
    { "id": "revoke.pages", "criterion": "C4", "path": "scenarios.lifecycle.revoke.pages", "op": "eq", "value": 0, "why": "no frame or webview of the package is left" },
    { "id": "revoke.channel", "criterion": "C4", "path": "scenarios.lifecycle.revoke.channel", "op": "eq", "value": "closed", "why": "after the revoke the service sees no instance and delivers nothing (or is refused)" },
    { "id": "disable.state", "criterion": "C4", "path": "scenarios.lifecycle.disable.panelState", "op": "match", "value": "^(disabled|gone)$", "why": "disabling the package ends its panel" },
    { "id": "disable.pages", "criterion": "C4", "path": "scenarios.lifecycle.disable.pages", "op": "eq", "value": 0, "why": "no frame or webview is left" },
    { "id": "disable.service", "criterion": "C4", "path": "scenarios.lifecycle.disable.serviceStopped", "op": "eq", "value": true, "why": "the service and its channel end" },
    { "id": "safe.pages", "criterion": "C4", "path": "scenarios.lifecycle.safeMode.pages", "op": "eq", "value": 0, "why": "safe mode leaves no panel of any package" },
    { "id": "safe.windows", "criterion": "C4", "path": "scenarios.lifecycle.safeMode.windows", "op": "eq", "value": 0, "why": "and no separate panel window" },
    { "id": "safe.service", "criterion": "C4", "path": "scenarios.lifecycle.safeMode.serviceStopped", "op": "eq", "value": true, "why": "and no service channel" },
    { "id": "safe.composer", "criterion": "C4", "path": "scenarios.lifecycle.safeMode.promptEnabled", "op": "eq", "value": true, "why": "the app stays usable" }
  ]
}
