    { "name": "a bare modifier is not a chord", "request": { "schemaVersion": 1, "session": "s", "kind": "key", "key": "Control", "code": "ControlLeft", "ctrlKey": true, "metaKey": false, "shiftKey": false, "altKey": false }, "forward": null },
