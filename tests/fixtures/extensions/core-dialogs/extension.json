{
  "manifestVersion": 1,
  "id": "sample.core-dialogs",
  "version": "1.0.0",
  "engines": {
    "pandacodeApi": "^1.0.0"
  },
  "extensionKind": "ui",
  "permissions": [
    "ui.contribute"
  ],
  "requiredContributions": [
    "dialogExtras"
  ],
  "contributes": {
    "icons": [
      {
        "id": "sample.core-dialogs/mark",
        "asset": "assets/note.svg"
      }
    ],
    "commands": [
      {
        "id": "sample.core-dialogs/note",
        "title": "Dialog note",
        "action": {
          "kind": "showMessage",
          "message": "Core dialog note: the host keeps this dialog"
        }
      },
      {
        "id": "sample.core-dialogs/follow-up",
        "title": "Follow-up",
        "action": {
          "kind": "showDialog",
          "dialog": {
            "title": "Dialog follow-up",
            "fields": [
              {
                "id": "note",
                "kind": "text",
                "label": "Follow-up note",
                "required": true
              },
              {
                "id": "kind",
                "kind": "select",
                "label": "Follow-up kind",
                "placeholder": "Choose a kind",
                "options": [
                  {
                    "value": "review",
                    "label": "Review later"
                  },
                  {
                    "value": "share",
                    "label": "Share with team"
                  },
                  {
                    "value": "archive",
                    "label": "Archive",
                    "disabled": true
                  }
                ]
              },
              {
                "id": "remind",
                "kind": "switch",
                "label": "Remind me"
              }
            ],
            "confirmLabel": "Record",
            "successMessage": "Dialog follow-up recorded",
            "cancelMessage": "Dialog follow-up cancelled"
          }
        }
      },
      {
        "id": "sample.core-dialogs/more",
        "title": "More dialog actions",
        "action": {
          "kind": "showMessage",
          "message": "Choose a dialog action"
        }
      },
      {
        "id": "sample.core-dialogs/unavailable",
        "title": "Unavailable dialog action",
        "enabled": false,
        "action": {
          "kind": "showMessage",
          "message": "Must never appear"
        }
      }
    ],
    "menus": [
      {
        "id": "sample.core-dialogs/recipes",
        "location": "panda.dialog.recipes.actions",
        "presentation": "button",
        "icon": "sample.core-dialogs/mark",
        "command": "sample.core-dialogs/note",
        "text": "Dialog note"
      },
      {
        "id": "sample.core-dialogs/attachment",
