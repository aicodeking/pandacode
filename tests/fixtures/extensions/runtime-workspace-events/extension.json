{
  "manifestVersion": 1,
  "id": "sample.workspace-events",
  "version": "1.0.0",
  "engines": { "pandacodeApi": "^1.0.0" },
  "extensionKind": "ui",
  "permissions": ["ui.contribute", "runtime.service", "events.workspace"],
  "runtime": { "kind": "node", "entrypoint": "main.cjs", "service": { "start": "onEnable" } },
  "contributes": {
    "commands": [
      { "id": "sample.workspace-events/control", "title": "Workspace events control", "action": { "kind": "runCommand" } }
    ],
    "menus": [{ "id": "sample.workspace-events/header", "location": "panda.workspace.header.actions", "command": "sample.workspace-events/control", "presentation": "button", "text": "Workspace events" }]
  }
}
